+// Removes all grants of |type| for |origin| whose session model is one-time
+// (i.e. valid until the last page of the origin is closed), the 158
+// equivalent of the 2023 UntilOriginClosed lifetime constraint.
+void RemoveSessionSettings(HostContentSettingsMap* content_settings,
+                           const url::Origin& origin,
+                           ContentSettingsType type) {
+  ContentSettingsForOneType session_settings =
+      content_settings->GetSettingsForOneType(
+          type, content_settings::mojom::SessionModel::ONE_TIME);
+
+  GURL url = origin.GetURL();
+  for (ContentSettingPatternSource& entry : session_settings) {
+    if (entry.metadata.session_model() ==
+            content_settings::mojom::SessionModel::ONE_TIME &&
+        entry.primary_pattern.Matches(url)) {
+      content_settings->SetWebsiteSettingCustomScope(
+          entry.primary_pattern, entry.secondary_pattern, type, base::Value());
+    }
+  }
+}
+
