<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE pkgmetadata SYSTEM "http://www.gentoo.org/dtd/metadata.dtd">
<pkgmetadata>
	<maintainer type="person">
		<email>PF4Public@users.noreply.github.com</email>
	</maintainer>
	<upstream>
		<remote-id type="github">ggml-org/llama.cpp</remote-id>
		<bugs-to>https://github.com/ggml-org/llama.cpp/issues</bugs-to>
	</upstream>
	<use>
		<flag name="build-online">Allow the build to download the npm registry (needed by the webui flag in the live ebuild)</flag>
		<flag name="cuda">Enable the NVIDIA CUDA GPU backend</flag>
		<flag name="examples">Build the example programs</flag>
		<flag name="hip">Enable the AMD ROCm/HIP GPU backend</flag>
		<flag name="openblas">Enable the OpenBLAS backend</flag>
		<flag name="opencl">Enable the OpenCL backend</flag>
		<flag name="openmp">Use OpenMP in the CPU backend</flag>
		<flag name="openssl">Use OpenSSL for HTTPS model downloads</flag>
		<flag name="rpc">Enable the RPC backend for distributed inference</flag>
		<flag name="vulkan">Enable the Vulkan backend</flag>
		<flag name="webui">Embed the prebuilt web UI in llama-server</flag>
	</use>
</pkgmetadata>
