inherit config multilib

DESCRIPTION="Utility to select the default electron slot"
VERSION="0.5"

# We do a lot of things in /usr and it's a bit of a pain to write this
# constantly.
USR_PATH="${EROOT%/}/usr"
# Prebuilt electron runtimes (dev-util/electron-bin) live in /opt. Each one
# also installs a /usr/bin/electron-bin-<major> entry point (a symlink into
# /opt), mirroring dev-lang/rust-bin's /usr/bin/rustc-bin-<ver> helper
# symlinks, so both source (/usr) and prebuilt (/opt) runtimes can be listed
# and selected.
OPT_PATH="${EROOT%/}/opt"

# A "selection" is the /usr/bin entry point it maps to:
#   source   -> electron-<major>      runtime in /usr/$(get_libdir)/electron-<major>
#   prebuilt -> electron-bin-<major>  runtime in /opt/electron-<major>

# The runtime directory backing a selection.
runtime_dir() {
	local entry=$1
	if [[ ${entry} == electron-bin-* ]]; then
		echo "${OPT_PATH}/electron-${entry#electron-bin-}"
	else
		echo "${USR_PATH}/$(get_libdir)/electron-${entry#electron-}"
	fi
}

# The active selection: whatever /usr/bin/electron points at. We create
# relative /usr/bin/electron symlinks (just the entry name), so the link
# target is the entry; take the basename to also accept absolute links.
active_entry() {
	if [[ -h "${USR_PATH}/bin/electron" ]] ; then
		local link
		link=$(readlink "${USR_PATH}/bin/electron")
		echo "${link##*/}"
	else
		echo "(none)"
	fi
}

# All available selections, sorted by major version; for the same major the
# prebuilt (bin) entry is listed first, mirroring eselect rust.
get_entries() {
	local major
	local majors
	local entries

	majors=$( {
		find "${USR_PATH}/$(get_libdir)/" -mindepth 1 -maxdepth 1 -type d -name 'electron-*' 2> /dev/null
		find "${OPT_PATH}/"                -mindepth 1 -maxdepth 1 -type d -name 'electron-*' 2> /dev/null
	} | sed -re 's#.*-([0-9]+)$#\1#' | sort -n | uniq )

	for major in ${majors} ; do
		if [[ -d "${OPT_PATH}/electron-${major}" ]] ; then
			entries+=( "electron-bin-${major}" )
		fi
		if [[ -d "${USR_PATH}/$(get_libdir)/electron-${major}" ]] ; then
			entries+=( "electron-${major}" )
		fi
	done

	echo ${entries[@]}
}

### List Action ###
describe_list() {
	echo "List available electron versions."
}

do_list() {
	local i
	local entries=( $(get_entries) )
	local active
	active=$(active_entry)

	write_list_start "Available electron versions:"
	for (( i = 0; i < ${#entries[@]}; i++ )) ; do
		[[ ${entries[i]} == "${active}" ]] && entries[i]=$(highlight_marker "${entries[i]}")
	done
	write_numbered_list -m "(none found)" "${entries[@]}"
}

### Show Action ###
describe_show() {
	echo "Show which electron version is currently active."
}

do_show() {
	local active
	active=$(active_entry)

	write_list_start "Current electron selection:"
	if [[ ${active} == "(none)" ]] ; then
		write_kv_list_entry "(unset)" ""
	else
		write_kv_list_entry "${active}" "$(runtime_dir "${active}")"
	fi
}

### Set Action ###
describe_set() {
	echo "Set a new electron version."
}

describe_set_parameters() {
	echo "<selection>"
}

describe_set_options() {
	echo "selection : number from the 'list' action, a major version, or an entry"
	echo "            name (electron-<major> / electron-bin-<major>)"
}

do_set() {
	local entry=${1-}

	[[ -z ${entry} ]] && die -q "You didn't tell me what to set the version to"
	[[ $# -gt 1 ]] && die -q "Too many parameters"

	# A bare number is a 'list' action index; if that is out of range it is
	# treated as a major version (electron-<n> source, else electron-bin-<n>).
	# Otherwise it is taken as an entry name verbatim.
	if is_number "${entry}" ; then
		local entries=( $(get_entries) )
		if [[ ${entry} -ge 1 && ${entry} -le ${#entries[@]} ]] ; then
			entry=${entries[entry-1]}
		elif [[ -d ${USR_PATH}/$(get_libdir)/electron-${entry} ]] ; then
			entry="electron-${entry}"
		elif [[ -d ${OPT_PATH}/electron-${entry} ]] ; then
			entry="electron-bin-${entry}"
		else
			die -q "Not a valid selection."
		fi
	fi

	# Validate: the /usr/bin entry point and its runtime must both exist.
	local runtime
	runtime=$(runtime_dir "${entry}")
	[[ -e ${USR_PATH}/bin/${entry} ]] || die -q "Not a valid selection: ${entry}"
	[[ -d ${runtime} ]] || die -q "Runtime ${runtime} not found for ${entry}"

	# If there's an active selection, unset that one first
	local active
	active=$(active_entry)
	if [[ "${active}" != "(none)" && "${active}" != "${entry}" ]] ; then
		echo -ne "Unsetting ${active} as default..."
		do_unset "${active}"
		echo "done."
	fi

	echo -ne "Setting ${entry} as the default..."

	# Point the libdir 'electron' symlink at the selected runtime dir
	ln -sfn "${runtime}" "${USR_PATH}/$(get_libdir)/electron" || \
		die -q "SYMLINK FAILED: ${runtime} -> ${USR_PATH}/$(get_libdir)/electron"

	# Point /usr/bin/electron at the selected entry point (relative link)
	ln -sfn "${entry}" "${USR_PATH}/bin/electron" || \
		die -q "SYMLINK FAILED: ${entry} -> ${USR_PATH}/bin/electron"

	echo "success!"
}

### Unset Action ###
describe_unset() {
	echo "Remove symbolic links."
}

# Undo everything done by do_set().
do_unset() {
	local entry=${1-}
	# with no argument, unset the currently active selection
	[[ -z ${entry} ]] && entry=$(active_entry)
	[[ ${entry} == "(none)" ]] && die -q "No active selection to unset"
	if [[ ${entry} != $(active_entry) ]] ; then
		echo "Selection already inactive; no work to do."
		return 0
	fi

	local runtime
	runtime=$(runtime_dir "${entry}")

	local bin_link="${USR_PATH}/bin/electron"
	local lib_link="${USR_PATH}/$(get_libdir)/electron"

	# /usr/bin/electron -> <entry>
	if [[ -h ${bin_link} ]] ; then
		local base
		base=$(readlink "${bin_link}")
		if [[ ${base##*/} == "${entry}" ]] ; then
			rm "${bin_link}" || write_warning_msg "Couldn't remove: ${bin_link}"
		fi
	fi

	# /usr/$(get_libdir)/electron -> <runtime>
	if [[ -h ${lib_link} && $(readlink "${lib_link}") == "${runtime}" ]] ; then
		rm "${lib_link}" || write_warning_msg "Couldn't remove: ${lib_link}"
	fi
}

### Update Action ###
describe_update() {
	echo "Refreshes all symbolic links managed by this module"
}

do_update() {
	local active
	active=$(active_entry)
	local entries=( $(get_entries) )
	local entry

	# If active is in the entries list, set it again as the installation
	# may have changed.
	for entry in ${entries[@]} ; do
		if [[ ${entry} == ${active} ]] ; then
			do_set "${active}"
			return
		fi
	done

	if [[ ${#entries[@]} -ne 0 ]] ; then
		# If $entries is not empty and active is not in the list, set the
		# highest version available.
		do_set "${entries[-1]}"
	elif [[ ${active} != "(none)" ]] ; then
		# If entries is empty, but active still has a value, an unset must
		# happen as the links are now pointing to nothing.
		do_unset "${active}"
	else
		echo "Apparently, I have nothing to do."
	fi
}
